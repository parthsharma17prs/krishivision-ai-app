# ========================================================
# KrishiVision AI — Root .gitignore
# ========================================================

# Environment and Secrets
.env
.env.*
!.env.example
!.env.local.example
!.env.production.example
*firebase-credentials*.json
!*firebase-credentials.example.json
*.pem
*.key
*.cert
*.crt
*.pfx

# Node & Frontend Build
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & Backend Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
eggs/
.eggs/
parts/
var/
sdist/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Machine Learning & Deep Learning Weights
# (Use scripts/download_models.py to download large model weights)
*.pt
*.pth
*.onnx
*.engine
*.bin
*.safetensors
*.h5
*.hdf5
*.pkl
*.pickle
*.weights
*.tflite

# Local Databases & State
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
krishivision.db
backend/krishivision.db

# Uploads, Reports & Runtime Generated Media
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/reports/
backend/uploads/reports/*
!backend/uploads/reports/.gitkeep
generated/
logs/
*.log

# IDE & Editor Configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary Files & Caches
*.tmp
*.temp
*.cache
*.pid
